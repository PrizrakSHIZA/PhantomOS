configuration {
    modi: "drun,run,window";
    show-icons: true;
    drun-display-format: "{name}";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    hover-select: true;
    me-accept-entry: "MousePrimary";
}

* {
    bg: #1a1b26f5;
    surface: #24283b;
    text: #c0caf5;
    muted: #565f89;
    blue: #7aa2f7;
    cyan: #7dcfff;
    purple: #bb9af7;
    magenta: #ff7a93;
    background-color: transparent;
    text-color: @text;
}

window {
    width: 42%;
    height: 58%;
    location: center;
    anchor: center;
    border: 2px;
    border-color: @purple;
    border-radius: 22px;
    background-color: @bg;
    padding: 24px;
}

mainbox {
    spacing: 16px;
    children: [inputbar, listview, mode-switcher];
}

inputbar {
    background-color: @surface;
    border: 1px;
    border-color: #414868;
    border-radius: 14px;
    padding: 13px 16px;
    children: [prompt, entry];
}

prompt {
    text-color: @cyan;
    padding: 0 10px 0 0;
}

entry {
    placeholder: "Найти приложение…";
    placeholder-color: @muted;
}

listview {
    columns: 2;
    lines: 4;
    fixed-height: true;
    fixed-columns: true;
    spacing: 9px;
    scrollbar: false;
    layout: vertical;
    cycle: true;
    dynamic: true;
}

element {
    border-radius: 14px;
    padding: 10px;
    orientation: vertical;
}

element normal.normal {
    background-color: @surface;
}

element selected.normal {
    background-color: @surface2;
    border: 1px;
    border-color: @blue;
}

element-icon {
    size: 42px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    padding: 8px 0 0;
}

mode-switcher {
    background-color: @surface;
    border-radius: 12px;
    padding: 7px;
}

button {
    border-radius: 9px;
    padding: 7px 12px;
}

button selected {
    background-color: @blue;
    text-color: #1a1b26;
}