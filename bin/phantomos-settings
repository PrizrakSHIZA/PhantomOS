#!/usr/bin/env python3
"""PhantomOS-branded settings hub for KDE Plasma."""
import os
import subprocess
import sys
from pathlib import Path

try:
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gdk, Gtk
except (ImportError, ValueError):
    os.execvp("systemsettings", ["systemsettings"])

HERE = Path(__file__).resolve().parent
CTL = str(HERE / "phantomosctl")
THEME = str(HERE / "phantomos-theme")
CSS = b"""
window { background: #171522; color: #eeeafa; }
headerbar { background: #211d32; border: 0; color: #eeeafa; min-height: 58px; }
headerbar .title { color: #eeeafa; font-weight: 800; }
.sidebar { background: #14121e; padding: 14px 10px; }
.nav-button { background: transparent; border: 0; border-radius: 10px; color: #aaa3bf; padding: 12px; text-align: left; }
.nav-button:hover { background: #29243d; color: #eeeafa; }
.nav-button:checked { background: #38304f; color: #c4a8ff; }
.page { padding: 26px 32px; }
.page-title { color: #eeeafa; font-size: 23px; font-weight: 700; }
.page-subtitle { color: #aaa3bf; margin-bottom: 18px; }
.card { background: #211d32; border: 1px solid #38304f; border-radius: 14px; padding: 16px; }
.card-title { color: #eeeafa; font-weight: 700; }
.card-description { color: #aaa3bf; }
button.action { background: #302a46; border: 1px solid #49405f; border-radius: 9px; color: #eeeafa; padding: 8px 12px; }
button.action:hover { background: #3a3154; border-color: #a78bfa; }
button.accent { background: #a78bfa; border-color: #a78bfa; color: #191522; font-weight: 700; }
"""
PAGES = {
 "home": ("PhantomOS", "\u041e\u0431\u0437\u043e\u0440 \u0438 \u0431\u044b\u0441\u0442\u0440\u044b\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f", "applications-system-symbolic"),
 "appearance": ("\u0422\u0435\u043c\u044b", "\u0427\u0435\u0442\u044b\u0440\u0435 \u0444\u0438\u0440\u043c\u0435\u043d\u043d\u044b\u0435 \u0442\u0435\u043c\u044b PhantomOS", "preferences-desktop-theme"),
 "display": ("\u0414\u0438\u0441\u043f\u043b\u0435\u0438", "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0435, \u0447\u0430\u0441\u0442\u043e\u0442\u0430 \u0438 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043c\u043e\u043d\u0438\u0442\u043e\u0440\u043e\u0432", "video-display"),
 "sound": ("\u0417\u0432\u0443\u043a", "\u0412\u044b\u0432\u043e\u0434, \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c \u0438 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440", "audio-card"),
 "input": ("\u041a\u043b\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0430 \u0438 \u043c\u044b\u0448\u044c", "\u0420\u0430\u0441\u043a\u043b\u0430\u0434\u043a\u0438 \u0438 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u044f \u043a\u043b\u0430\u0432\u0438\u0448", "input-keyboard"),
 "network": ("\u0421\u0435\u0442\u044c", "\u0421\u0435\u0442\u0435\u0432\u044b\u0435 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f \u0438 Bluetooth", "network-workgroup"),
 "account": ("\u0423\u0447\u0451\u0442\u043d\u0430\u044f \u0437\u0430\u043f\u0438\u0441\u044c", "\u042d\u043a\u0440\u0430\u043d \u0432\u0445\u043e\u0434\u0430, \u043f\u0430\u0440\u043e\u043b\u044c \u0438 \u0430\u0432\u0442\u043e\u0437\u0430\u043f\u0443\u0441\u043a", "system-users"),
}

def run(command):
    try:
        subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as error:
        print(f"PhantomOS Settings: {error}", file=sys.stderr)

class SettingsWindow(Gtk.Window):
    def __init__(self):
        super().__init__(title="PhantomOS Settings")
        self.set_default_size(1040, 700)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("phantomos")
        provider = Gtk.CssProvider()
        theme_palette = {"purple": (b"#171522", b"#211d32", b"#302a46", b"#a78bfa"), "green": (b"#111a15", b"#19261e", b"#24352a", b"#7ee787"), "pink": (b"#211720", b"#30202c", b"#402a39", b"#ff9fca"), "yellow": (b"#201a11", b"#302719", b"#42351f", b"#ffd166")}
        try:
            selected_theme = (Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "phantomos/theme").read_text().strip()
        except OSError:
            selected_theme = "purple"
        background, panel, card, accent = theme_palette.get(selected_theme, theme_palette["purple"])
        themed_css = CSS.replace(b"#171522", background).replace(b"#211d32", panel).replace(b"#302a46", card)
        themed_css = themed_css.replace(b"#a78bfa", accent).replace(b"#c4a8ff", accent)
        provider.load_from_data(themed_css)
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(root)
        header = Gtk.HeaderBar(title="PHANTOMOS", show_close_button=True)
        header.set_subtitle("\u0426\u0435\u043d\u0442\u0440 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f")
        self.set_titlebar(header)
        body = Gtk.Box(spacing=0)
        root.pack_start(body, True, True, 0)
        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
        sidebar.set_size_request(218, -1)
        sidebar.get_style_context().add_class("sidebar")
        body.pack_start(sidebar, False, False, 0)
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, transition_duration=180)
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)
        body.pack_start(self.stack, True, True, 0)
        self.nav_buttons = {}
        for key in PAGES:
            title, _subtitle, icon = PAGES[key]
            button = Gtk.ToggleButton(label=title)
            button.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU))
            button.set_always_show_image(True)
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.get_style_context().add_class("nav-button")
            button.connect("clicked", self.show_page, key)
            sidebar.pack_start(button, False, False, 0)
            self.nav_buttons[key] = button
            self.stack.add_named(self.create_page(key), key)
        initial = "appearance" if "--page" in sys.argv and "appearance" in sys.argv else "home"
        self.show_page(None, initial)

    def create_page(self, key):
        title, subtitle, _icon = PAGES[key]
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        page.get_style_context().add_class("page")
        heading = Gtk.Label(label=title, xalign=0)
        heading.get_style_context().add_class("page-title")
        page.pack_start(heading, False, False, 0)
        detail = Gtk.Label(label=subtitle, xalign=0, wrap=True)
        detail.get_style_context().add_class("page-subtitle")
        page.pack_start(detail, False, False, 0)
        if key == "home":
            self.add_card(page, "\u0420\u0435\u0436\u0438\u043c \u0440\u0430\u0431\u043e\u0447\u0435\u0433\u043e \u0441\u0442\u043e\u043b\u0430", "\u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0442\u0430\u0439\u043b\u0438\u043d\u0433 \u0438 \u043f\u043b\u0430\u0432\u0430\u044e\u0449\u0438\u0435 \u043e\u043a\u043d\u0430.", [("\u0420\u0430\u0431\u043e\u0447\u0438\u0439", [CTL, "work"], True), ("\u041e\u0442\u0434\u044b\u0445", [CTL, "relax"], False)])
            self.add_card(page, "\u0411\u044b\u0441\u0442\u0440\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f", "\u041f\u0430\u043d\u0435\u043b\u044c \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0438 \u043c\u0435\u043d\u044e \u041f\u0443\u0441\u043a.", [("\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 KDE", ["systemsettings"], False), ("\u041c\u0435\u043d\u044e \u041f\u0443\u0441\u043a", [str(HERE / "phantomos-start")], True)])
        elif key == "appearance":
            self.add_card(page, "\u0422\u0435\u043c\u044b PhantomOS", "\u041f\u0430\u043b\u0438\u0442\u0440\u0430 \u0438 \u043e\u0431\u043e\u0438 \u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u0432\u043c\u0435\u0441\u0442\u0435.", [("\u0424\u0438\u043e\u043b\u0435\u0442\u043e\u0432\u044b\u0439 Phantom", [THEME, "purple"], True), ("\u0417\u0435\u043b\u0451\u043d\u044b\u0439 Necromancer", [THEME, "green"], False), ("\u0420\u043e\u0437\u043e\u0432\u044b\u0439 Cat", [THEME, "pink"], False), ("\u0416\u0451\u043b\u0442\u044b\u0439 Solar", [THEME, "yellow"], False)])
            self.add_card(page, "\u042d\u0444\u0444\u0435\u043a\u0442\u044b \u043e\u043a\u043e\u043d", "\u0410\u043d\u0438\u043c\u0430\u0446\u0438\u0438 KWin.", [("KWin", ["systemsettings", "kcm_kwin_effects"], False)])
        elif key == "display":
            self.add_card(page, "\u041c\u043e\u043d\u0438\u0442\u043e\u0440\u044b", "\u0412\u044b\u0431\u043e\u0440 \u044d\u043a\u0440\u0430\u043d\u0430, \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f.", [("\u0414\u0438\u0441\u043f\u043b\u0435\u0438", ["systemsettings", "kcm_kscreen"], True)])
        elif key == "sound":
            self.add_card(page, "\u0417\u0432\u0443\u043a \u0438 \u044d\u043a\u0432\u0430\u043b\u0430\u0439\u0437\u0435\u0440", "\u0412\u044b\u0445\u043e\u0434\u044b, \u0432\u0445\u043e\u0434\u044b \u0438 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u043a\u0430 \u0437\u0432\u0443\u043a\u0430.", [("\u0417\u0432\u0443\u043a", ["systemsettings", "kcm_pulseaudio"], True), ("EasyEffects", ["easyeffects"], False)])
        elif key == "input":
            self.add_card(page, "\u041a\u043b\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u0430", "US/RU; Ctrl+Shift \u043c\u0435\u043d\u044f\u0435\u0442 \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u043a\u0443.", [("\u0420\u0430\u0441\u043a\u043b\u0430\u0434\u043a\u0438", ["systemsettings", "kcm_keyboard"], True), ("\u0421\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u044f", ["systemsettings", "kcm_keys"], False), ("\u041c\u044b\u0448\u044c", ["systemsettings", "kcm_mouse"], False)])
        elif key == "network":
            self.add_card(page, "\u0421\u0435\u0442\u044c \u0438 Bluetooth", "\u0421\u043e\u0435\u0434\u0438\u043d\u0435\u043d\u0438\u044f \u0438 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430.", [("NetworkManager", ["systemsettings", "kcm_networkmanagement"], True), ("Bluetooth", ["blueman-manager"], False)])
        elif key == "account":
            self.add_card(page, "\u0412\u0445\u043e\u0434 \u0438 \u0443\u0447\u0451\u0442\u043d\u0430\u044f \u0437\u0430\u043f\u0438\u0441\u044c", "\u041f\u0430\u0440\u043e\u043b\u044c, SDDM \u0438 \u0430\u0432\u0442\u043e\u043b\u043e\u0433\u0438\u043d.", [("SDDM", ["systemsettings", "kcm_sddm"], False), ("\u041f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u0438", ["systemsettings", "kcm_users"], False), ("\u0410\u0432\u0442\u043e\u0437\u0430\u043f\u0443\u0441\u043a", ["systemsettings", "kcm_autostart"], False)])
        return page

    def add_card(self, page, title, description, actions):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=9)
        card.get_style_context().add_class("card")
        heading = Gtk.Label(label=title, xalign=0)
        heading.get_style_context().add_class("card-title")
        card.pack_start(heading, False, False, 0)
        detail = Gtk.Label(label=description, xalign=0, wrap=True)
        detail.get_style_context().add_class("card-description")
        card.pack_start(detail, False, False, 0)
        row = Gtk.FlowBox(orientation=Gtk.Orientation.HORIZONTAL, selection_mode=Gtk.SelectionMode.NONE)
        row.set_column_spacing(8)
        row.set_row_spacing(8)
        for label, command, accent in actions:
            button = Gtk.Button(label=label)
            button.get_style_context().add_class("action")
            if accent:
                button.get_style_context().add_class("accent")
            button.connect("clicked", lambda _button, cmd=command: run(cmd))
            row.add(button)
        card.pack_start(row, False, False, 0)
        page.pack_start(card, False, False, 0)

    def show_page(self, _button, key):
        self.stack.set_visible_child_name(key)
        for item, button in self.nav_buttons.items():
            button.set_active(item == key)

if __name__ == "__main__":
    window = SettingsWindow()
    window.connect("destroy", Gtk.main_quit)
    window.show_all()
    Gtk.main()
