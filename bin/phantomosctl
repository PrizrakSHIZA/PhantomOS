#!/usr/bin/env bash
set -euo pipefail

action="${1:-help}"
notify() { command -v notify-send >/dev/null 2>&1 && notify-send --app-name=PhantomOS PhantomOS "$1" || true; }
invoke_kwin() {
    command -v qdbus6 >/dev/null 2>&1 || { notify 'KDE DBus tools are missing.'; return 1; }
    qdbus6 org.kde.kglobalaccel /component/kwin org.kde.kglobalaccel.Component.invokeShortcut 'PhantomOS: Toggle Work/Relax'
}
case "$action" in
    toggle) invoke_kwin ;;
    work|relax)
        command -v qdbus6 >/dev/null 2>&1 || { notify 'KDE DBus tools are missing.'; exit 1; }
        qdbus6 org.kde.kglobalaccel /component/kwin org.kde.kglobalaccel.Component.invokeShortcut "PhantomOS: ${action^} Mode"
        ;;
    mode)
        if command -v kreadconfig6 >/dev/null 2>&1; then
            current="$(kreadconfig6 --file phantomosrc --group PhantomOS --key Mode --default work)"
            printf 'PhantomOS mode: %s\n' "$current"
        else
            printf 'PhantomOS mode state is unavailable until Plasma starts.\n'
        fi
        ;;
    menu|start) exec "$(dirname -- "${BASH_SOURCE[0]}")/phantomos-start" ;;
    settings)
        settings_app="$(dirname -- "${BASH_SOURCE[0]}")/phantomos-settings"
        if [[ -x "$settings_app" ]]; then exec "$settings_app"; fi
        systemsettings
        ;;
    power)
        choice="$(kdialog --menu 'PhantomOS Power' lock 'Lock screen' sleep 'Suspend' logout 'Log out' reboot 'Restart' shutdown 'Power off' 2>/dev/null || true)"
        case "$choice" in
            lock) qdbus6 org.freedesktop.ScreenSaver /ScreenSaver Lock || loginctl lock-session ;;
            sleep) systemctl suspend ;;
            logout) qdbus6 org.kde.Shutdown /Shutdown logout || qdbus6 org.kde.ksmserver /KSMServer logout 0 0 0 ;;
            reboot) systemctl reboot ;;
            shutdown) systemctl poweroff ;;
        esac
        ;;
    wallpaper) systemsettings kcm_wallpaper ;;
    screenshot|screenshot-screen) exec spectacle --desktopfile org.kde.spectacle.desktop --background --nonotify --copy-image --fullscreen ;;
    screenshot-window) exec spectacle --desktopfile org.kde.spectacle.desktop --background --nonotify --copy-image --activewindow ;;
    screenshot-region) exec spectacle --desktopfile org.kde.spectacle.desktop --background --nonotify --copy-image --region ;;
    help|-h|--help)
        cat <<'HELP'
PhantomOS commands
  phantom help       Show commands
  phantom update     Update this desktop flavor from Git
  phantom toggle     Switch tiled/floating mode (Meta+Tab)
  phantom work       Select tiled mode
  phantom relax      Select floating mode
  phantom settings   Open PhantomOS Settings Center
  phantom menu       Open the PhantomOS Start menu
  phantom power      Open power actions
HELP
        ;;
    *) printf 'Unknown PhantomOS action: %s\n' "$action" >&2; exit 2 ;;
esac
