[Desktop Entry]
Name=btop
Name[ru]=Системный монитор btop
Comment=Process and resource monitor
Comment[ru]=Монитор процессов, памяти, дисков и сети
Exec=wezterm start --always-new-process -- btop
Icon=utilities-system-monitor
Terminal=false
Type=Application
Categories=System;Monitor;
Keywords=system;processes;cpu;memory;monitor;
