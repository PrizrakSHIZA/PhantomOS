# Maintainer: PhantomOS contributors
pkgname=phantomos-plasma-git
pkgver=r1.20261028
pkgrel=1
pkgdesc='PhantomOS Plasma desktop with tiled Work and floating Relax modes'
arch=('any')
url='https://github.com/PrizrakSHIZA/PhantomOS'
license=('custom')
depends=(
  'bash' 'bluez' 'bluez-utils' 'blueman' 'btop' 'audacious' 'haruna' 'xdg-utils'
  'code' 'easyeffects' 'git' 'kwin-polonium' 'kitty' 'micro' 'networkmanager'
  'noto-fonts' 'noto-fonts-emoji' 'papirus-icon-theme' 'pavucontrol'
  'pipewire' 'pipewire-alsa' 'pipewire-audio' 'pipewire-pulse' 'python'
  'plasma-meta' 'sddm' 'sddm-kcm' 'kdialog' 'spectacle' 'systemsettings' 'dolphin' 'konsole'
  'grim' 'slurp' 'gtk3' 'python-gobject' 'ttf-font-awesome' 'ttf-jetbrains-mono-nerd' 'wireplumber'
  'wl-clipboard' 'xdg-desktop-portal' 'xdg-desktop-portal-kde'
)
makedepends=('git')
provides=('phantomos')
conflicts=('phantomos' 'phantomos-git')
source=("$pkgname::git+https://github.com/PrizrakSHIZA/PhantomOS.git#branch=plasma")
sha256sums=('SKIP')
install=phantomos.install

pkgver() {
  cd "$srcdir/$pkgname"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git log -1 --format=%cd --date=format:%Y%m%d)"
}

package() {
  cd "$srcdir/$pkgname"
  install -d "$pkgdir/usr/share/phantomos"
  cp -a . "$pkgdir/usr/share/phantomos/"
  rm -rf "$pkgdir/usr/share/phantomos/.git" "$pkgdir/usr/share/phantomos/packaging"
  install -Dm755 packaging/aur/phantom-wrapper "$pkgdir/usr/bin/phantom"
  install -Dm755 bin/phantomosctl "$pkgdir/usr/bin/phantomosctl"
  install -Dm755 bin/phantomos-settings "$pkgdir/usr/bin/phantomos-settings"
  install -Dm755 bin/phantomos-start "$pkgdir/usr/bin/phantomos-start"
  install -Dm755 bin/phantomos-theme "$pkgdir/usr/bin/phantomos-theme"
  install -Dm755 bin/phantomos-sddm-autologin "$pkgdir/usr/lib/phantomos/phantomos-sddm-autologin"
  install -Dm644 assets/sddm/phantomos/Main.qml "$pkgdir/usr/share/sddm/themes/phantomos/Main.qml"
  install -Dm644 assets/sddm/phantomos/metadata.desktop "$pkgdir/usr/share/sddm/themes/phantomos/metadata.desktop"
  install -Dm644 assets/sddm/phantomos/theme.conf "$pkgdir/usr/share/sddm/themes/phantomos/theme.conf"
  install -Dm644 assets/sddm/90-phantomos-theme.conf "$pkgdir/usr/lib/sddm/sddm.conf.d/90-phantomos-theme.conf"
}
