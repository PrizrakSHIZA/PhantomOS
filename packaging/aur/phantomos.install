post_install() {
    cat <<'EOF'
PhantomOS files are installed. Run `phantom setup` as your regular user to
install the Plasma configuration and create user-level launchers.
Enable the graphical login with `sudo systemctl enable sddm.service` if no
other display manager is already enabled.
Update the AUR package with `yay -Syu phantomos-plasma-git`.
EOF
}

post_upgrade() {
    post_install
}
